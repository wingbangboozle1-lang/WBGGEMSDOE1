# Large, reproducible inputs and caches are not submission deliverables.
.venv/
.cache/
__pycache__/
.pytest_cache/
.ruff_cache/
node_modules/
coverage/
*.pyc
data/*
!data/README.md
evidence/*.log
*.partial
*.tmp
# Only explicitly generated, reviewed research TIFFs belong in docs/downloads/.

# Editable-install / optional coverage metadata.
*.egg-info/
.coverage
htmlcov/
# Inherited parallel-lane caches remain reproducible, not release artifacts.
.mypy_cache/
.DS_Store
registry/cache/
/submissions/
/artifacts/
